#!/bin/sh
# Run the validator before each commit. Enable once per clone:
#   git config core.hooksPath .githooks
cd "$(git rev-parse --show-toplevel)" || exit 1
if [ -x .venv/bin/python ]; then PY=.venv/bin/python; else PY=python3; fi
$PY scripts/validate.py || { echo "pre-commit: validator failed; commit aborted." >&2; exit 1; }
